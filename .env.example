# Local Stage 0 runtime. Real student data must not be committed.
LEARNINGFLOW_DB_PATH=data/learningflow.db

# Default is stdio. Use streamable-http only for local integration testing
# until authentication / authorization and deployment transport security exist.
LEARNINGFLOW_MCP_TRANSPORT=stdio
LEARNINGFLOW_MCP_HOST=127.0.0.1
LEARNINGFLOW_MCP_PORT=8000
